# Postgres. Inside docker compose the host is the `db` service; from the host
# machine it is published on POSTGRES_PORT (5433 by default, to stay out of the
# way of a local Postgres on 5432).
POSTGRES_PORT=5433
DATABASE_URL="postgresql://eventr:eventr@localhost:5433/eventr?schema=public"

# Public origin — used in magic links, QR codes and email links.
# APP_PORT is the host port docker compose publishes the app on.
APP_PORT=3100
APP_URL="http://localhost:3100"

# 32+ random bytes. Generate with: openssl rand -base64 48
SESSION_SECRET="change-me-openssl-rand-base64-48"

# Resend. Leave RESEND_API_KEY empty to write email previews to disk instead
# of sending, which is how local Docker runs without credentials.
RESEND_API_KEY=""
EMAIL_FROM="Eventr <no-reply@instantoffr.com>"

# Where email previews are written when RESEND_API_KEY is empty (see above).
# In compose this is a named volume so they survive container restarts.
# Unrelated to uploaded files — those go to S3 below.
UPLOADS_DIR="./uploads"

# S3-compatible object storage for uploaded logos and generated posters.
# Works against real AWS S3 or any S3-compatible provider (MinIO, Cloudflare
# R2, DigitalOcean Spaces, Backblaze B2, a self-hosted Garage/SeaweedFS, ...)
# — point S3_ENDPOINT at that provider.
#
# The bucket must allow public GetObject: files are served by linking
# straight to the object, not proxied through the app. On AWS, that means
# turning off "Block public access" for bucket policies and attaching one
# granting s3:GetObject on arn:aws:s3:::<bucket>/* to "Principal": "*".
S3_BUCKET="eventr-uploads"
S3_ENDPOINT="https://s3.eu-west-1.amazonaws.com"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# "auto" works for Cloudflare R2 and most self-hosted providers. On real AWS
# S3, set this to your bucket's actual region (e.g. "eu-west-1") — request
# signing fails otherwise.
S3_REGION="auto"

# Optional SMS provider for winner notifications. Unset disables SMS.
SMS_PROVIDER=""
SMS_API_KEY=""
SMS_FROM=""
